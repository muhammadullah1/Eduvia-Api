# Eduvia API environment template. Copy to `.env` (git-ignored) or set these in the host's env settings.
# Placeholders only: never commit real values. Development/test can instead use the untracked
# config/environments/{development,test}.json files; staging/production read only the environment.
# In staging/production the API refuses to start if a variable marked [required] is missing or unsafe.

# --- Runtime ---------------------------------------------------------------
# development | test | staging | production
NODE_ENV=staging
# Port the HTTP server listens on (the host usually injects PORT).
PORT=8080
# Bind address (0.0.0.0 inside a container / PaaS).
IP_ADDRESS=0.0.0.0
APP_VERSION=1.0.0
# pino level: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Database (PostgreSQL) -- all [required] -------------------------------
DATABASE_HOST=your-db-host.example.com
DATABASE_PORT=5432
DATABASE_NAME=eduvia_stage
DATABASE_USERNAME=eduvia_app
DATABASE_PASSWORD=replace-with-db-password

# --- Auth -------------------------------------------------------------------
# [required] Random, at least 32 characters, e.g. `openssl rand -base64 48`. The default
# "change-me-in-production" and shorter values are rejected.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# --- Frontend / CORS ----------------------------------------------------------
# [required] Portal URL used in email links. https, not localhost.
FRONT_END_URL=https://stage.your-portal.example.com
# [required] Comma-separated browser origins allowed to call the API with credentials (https, no path).
ALLOWED_ORIGINS=https://stage.your-portal.example.com

# --- Refresh cookie (eduvia_refresh, Path=/api/auth, httpOnly) ----------------
# Leave empty for the per-environment default:
#   staging/production -> Secure + SameSite=None (portal and API on different sites)
#   development/test   -> not Secure + SameSite=Lax (plain http://localhost)
# SameSite=none requires COOKIE_SECURE=true; staging/production refuse COOKIE_SECURE=false.
COOKIE_SECURE=
# lax | strict | none
COOKIE_SAMESITE=
# Optional cookie Domain. Leave empty to scope the cookie to the API host only (recommended).
COOKIE_DOMAIN=

# Express "trust proxy": empty = 1 hop in staging/production, off in development/test.
# Also accepts true, false, a hop count or a trust string such as "loopback".
TRUST_PROXY=

# --- Email (Resend) -------------------------------------------------------------
# [required] Resend API key for a verified sending domain.
RESEND_API_KEY=replace-with-resend-api-key
# [required] Sender on a domain verified in Resend.
EMAIL_FROM=noreply@your-domain.example.com
EMAIL_FROM_NAME=Eduvia

# --- File storage (Cloudflare R2, private bucket, presigned URLs) --------------------
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
# [required]
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# [required]
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# [required]
CLOUDFLARE_R2_BUCKET=eduvia-stage
# [required] https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Leave empty: the bucket is private and files are served through presigned GET URLs.
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# --- Base-school seeder (only when running the seed command; unset afterwards) ------
# See database/seeders/20261031120000-eduvia-base-school.js and docs/DEPLOYMENT-STAGE.md.
SEED_SCHOOL_NAME=Example School
SEED_SCHOOL_EMAIL=office@your-domain.example.com
SEED_EMAIL_DOMAIN=your-domain.example.com
SEED_SCHOOL_CODE=
SEED_SCHOOL_PHONE=
SEED_SCHOOL_ADDRESS=
SEED_SCHOOL_WEBSITE=
# At least 8 characters each.
SEED_SUPER_ADMIN_PASSWORD=replace-me
SEED_OPERATIONS_MANAGER_PASSWORD=replace-me
SEED_ACCOUNTANT_PASSWORD=replace-me
SEED_TEACHER_PASSWORD=replace-me
# Optional academic session: set all three or none (YYYY-MM-DD).
SEED_SESSION_NAME=
SEED_SESSION_START=
SEED_SESSION_END=
