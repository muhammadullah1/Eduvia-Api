{
  "name": "eduvia-api",
  "version": "1.0.0",
  "description": "Eduvia school management API for Creative Leaders School",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "npx eslint .",
    "prettier": "npx prettier -c .",
    "prettier:fix": "npx prettier --write .",
    "test": "NODE_ENV=test npx jest --config tests/jest.config.js --passWithNoTests",
    "db:migrate": "npx sequelize db:migrate",
    "db:migrate:undo": "npx sequelize db:migrate:undo",
    "db:migrate:status": "npx sequelize db:migrate:status",
    "db:migrate:create": "npx sequelize migration:generate --name",
    "db:seed": "npx sequelize db:seed:all",
    "db:seed:undo": "npx sequelize db:seed:undo",
    "db:seed:create": "npx sequelize-cli seed:generate --name"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "convict": "^6.2.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.2.0",
    "sequelize": "^6.37.1"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "prettier": "3.3.3",
    "sequelize-cli": "^6.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
